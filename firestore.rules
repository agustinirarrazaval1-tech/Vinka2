rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo la cuenta de VINCA puede cambiar el stock. Se identifica por su UID
    // (Firebase → Authentication → Usuarios, columna "UID de usuario") y no por
    // el correo: el UID no se puede recuperar ni volver a crear con otra cuenta.
    // Reemplaza PEGAR_UID_ADMIN por ese UID antes de publicar estas reglas.
    function esVinca() {
      return request.auth != null && request.auth.uid == 'PEGAR_UID_ADMIN';
    }
    function datosValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'stock', 'actualizado'])
          && d.nombre is string && d.nombre.size() <= 40
          && d.stock is int && d.stock >= 0 && d.stock <= 10000
          && d.actualizado == request.time;
    }
    // Cualquiera puede ver el stock; solo la cuenta de VINCA puede cambiarlo.
    // Acepta cualquier modelo (id en minúsculas, números o guiones), así que
    // al cambiar la colección no hay que volver a tocar estas reglas.
    match /productos/{producto} {
      allow read: if true;
      allow create, update: if esVinca()
                            && producto.matches('^[a-z0-9-]{1,40}$')
                            && datosValidos();
      allow delete: if esVinca();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
