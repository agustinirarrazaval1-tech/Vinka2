rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera puede ver el stock; solo la cuenta de VINCA puede cambiarlo.
    match /productos/{producto} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'vincatech@vinca.cl'
                   && producto in ['cefalu', 'menfi', 'volterra']
                   && request.resource.data.stock is int
                   && request.resource.data.stock >= 0;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
